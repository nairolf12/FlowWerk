# flowWerk – flow-werk.de bei netcup
# Stand: 25.11.2026

AddDefaultCharset UTF-8
Options -Indexes

# Eigene Fehlerseite
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Alles auf https://flow-werk.de (ohne www) leiten
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://flow-werk.de%{REQUEST_URI} [R=301,L]

  # Alte Produktseite finFlow -> sumFlow
  RewriteRule ^finflow\.html$ /sumflow.html [R=301,L]

  # Versteckte Dateien (.git, .htaccess usw.) sperren
  RewriteRule (^|/)\. - [F]
</IfModule>

# Installer immer als Download ausliefern
<FilesMatch "\.(dmg|exe)$">
  Header set Content-Disposition attachment
</FilesMatch>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType application/xml .xml
</IfModule>

# Caching: Schriften und Bilder lange, Seiten kurz
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# Sicherheits-Header
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
